---
/**
 * Renders an Astro Layout that renders an HTML page with metadata for SEO purposes and slots in the content of each page.
 * @component
 * @example
 * ```astro
 * <Layout
 *   title={title}
 *   description={description}
 *   modDate={modDate}
 *   canonical={canonical}
 *   template={template}
 *   activeMenu={activeMenu}
 *   breadcrumbArray={breadcrumbArray}
 * />
 * ```
 * @property {string} title - A string representing the title of the page
 * @property {string} description - A string representing the description of the page
 * @property {string} modDate - An optional string representing the modification date of the page
 * @property {string | false} canonical - The canonical URL of the page; `false` for a page that has no address of its
 *   own (the not-found page). Defaults to the page's own address.
 * @property {string} template - A string representing the template used for the page
 * @property {string} [activeMenu] - An optional string representing the active menu item
 * @property {BreadcrumbItem[]} breadcrumbArray - An array of objects representing the breadcrumb navigation
 * @returns {astro.AstroNode} The rendered HTML layout with metadata and components.
 */

import '@style';
import {
	ACCENT_COLOR,
	type BreadcrumbItem,
	LANGUAGE,
	LANGUAGE_EXTENDED,
	ROBOTS,
	SITE_DESCRIPTION,
	SITE_NAME,
	SITE_TITLE,
	SITE_TYPE,
	TWITTER_CARD,
	TWITTER_CREATOR,
	TWITTER_SITE,
} from '@config';
import { cardKind, shareCardAlt, shareCardPath } from '@utils/shareCard';
import Analytics from '@components/Analytics.astro';
import { ClientRouter } from 'astro:transitions';
import Footer from '@components/Footer.astro';
import Header from '@components/Header.astro';

interface Props {
	title: string;
	description: string;
	modDate?: string | undefined;
	canonical?: string | URL | false;
	template: string;
	activeMenu?: string | undefined;
	breadcrumbArray?: BreadcrumbItem[];
	/** Short facts the share card shows in chips: a resource's type and rating. */
	cardFacts?: readonly { text: string; color?: string }[];
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	// ISO 8601. A page without a date of its own prints no publication date.
	modDate,
	canonical = Astro.url,
	template,
	activeMenu,
	breadcrumbArray,
	cardFacts = [],
} = Astro.props satisfies Props;

// Every page has its own share card. The build draws it from this page's title and the resurse:card tag below
// (src/integrations/shareCards.ts): the kind of page, the trail of the breadcrumb without the page itself, the facts.
const ogImage = new URL(shareCardPath(Astro.url.pathname), Astro.site);
const card = JSON.stringify({ kind: cardKind(template), trail: (breadcrumbArray ?? []).slice(0, -1).map((item) => item.label), facts: cardFacts });
// The article:* dates belong to the article type of Open Graph, so a page with a date of its own is an article.
const ogType = modDate ? 'article' : SITE_TYPE;
---

<!doctype html>
<html lang={LANGUAGE}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>

		<link rel="prefetch" href="/font/atkinson-hyperlegible-regular.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="prefetch" href="/font/atkinson-hyperlegible-bold.woff2" as="font" type="font/woff2" crossorigin />

		<!-- SEO -->
		{canonical && <link rel="canonical" href={canonical} />}
		<meta name="description" content={description} />
		<meta name="robots" content={ROBOTS} />

		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		<meta property="og:locale" content={LANGUAGE_EXTENDED} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={shareCardAlt(title)} />
		<meta name="twitter:card" content={TWITTER_CARD} />
		<meta name="twitter:site" content={TWITTER_SITE} />
		<meta name="twitter:creator" content={TWITTER_CREATOR} />
		<meta name="resurse:card" content={card} />
		{modDate && <meta property="article:published_time" content={modDate} />}
		{modDate && <meta property="article:modified_time" content={modDate} />}

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#00214d" />
		<meta name="msapplication-TileColor" content={ACCENT_COLOR} />
		<meta name="apple-mobile-web-app-title" content={`${SITE_NAME} - ${title}`} />
		<meta name="application-name" content={SITE_NAME} />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-touch-fullscreen" content="yes" />
		<meta name="theme-color" content={ACCENT_COLOR} />

		<link rel="author" href="https://resurse.dev/humans.txt" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<ClientRouter fallback="none" />
	</head>
	<body class:list={[template]}>
		<a id="skip" href="#hero" title="Mergi direct la conținutul acestei pagini">Mergi la conținut</a>
		<div class="Framework">
			<Header breadcrumbArray={breadcrumbArray} activeMenu={activeMenu} />
			<slot />
			<Footer activeMenu={activeMenu} />
		</div>
		<Analytics />
	</body>
</html>
