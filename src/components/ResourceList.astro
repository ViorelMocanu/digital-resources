---
/**
 * Renders the resource list. Is used in multiple locations throughout every resource listing page.
 * @component
 * @example
 * ```astro
 * <ResourceList resources={theResources} page={thePage} pageTitle="The page title" />
 * ```
 * @property {CollectionEntry<"resources">[]} resources - The list of resources.
 * @property {Object} [page] - The optional page object.
 * @property {number} page.currentPage - The current page number.
 * @property {number} page.lastPage - The last page number.
 * @property {Object} page.url - The URL object.
 * @property {string} page.url.[next] - The URL for the next page.
 * @property {string} page.url.[prev] - The URL for the previous page.
 * @returns {astro.AstroNode} The rendered resource list component.
 */

import { type ExtendedResource, resourceTypeIcon } from '@config';
import { type CollectionEntry } from 'astro:content';
import HelpfulLinks from '@components/HelpfulLinks.astro';
import Message from '@components/Message.astro';
import Pagination from '@components/Pagination.astro';
import ResourceActionList from '@components/ResourceActionList.astro';
import ResourceLocationList from '@components/ResourceLocationList.astro';
import ResourceTagList from '@components/ResourceTagList.astro';
import { collections } from '@utils/collections';
import { formatRating } from '@utils/resourceMeta';

export interface Props {
	resources: CollectionEntry<'resources'>[];
	page?: {
		currentPage: number;
		lastPage: number;
		url: {
			// Astro gives `first` from page 2 on; `current` is the first page itself on page 1.
			current: string;
			first?: string | undefined;
			next?: string;
			prev?: string;
		};
	};
	pageTitle?: string | undefined;
}

const { resources, page, pageTitle } = Astro.props satisfies Props;

let r = resources as unknown as ExtendedResource[];
const [tagsById, sectionsById, categoriesById, subCategoriesById] = await Promise.all([
	collections.byId('tags'),
	collections.byId('sections'),
	collections.byId('categories'),
	collections.byId('subcategories'),
]);

if (resources) {
	r.forEach((resource: ExtendedResource) => {
		if (resource.data.tags !== null) {
			let tagData: CollectionEntry<'tags'>[] = [];
			resource.data.tags.forEach((tag: { id: string; collection: string }) => {
				const currentTag = tagsById.get(tag.id);
				if (currentTag && typeof currentTag.data !== 'undefined') {
					tagData.push(currentTag);
				}
			});
			resource['tagData'] = tagData;
		}

		if (resource.data.section !== null) {
			const section = sectionsById.get(resource.data.section.id);
			if (section) resource.sectionData = section;
		}

		// Always a list, empty when the resource names none: the schema lets both fields be left out.
		resource['categoryData'] = (resource.data.categories ?? []).flatMap((cat: { id: string; collection: string }) => categoriesById.get(cat.id) ?? []);
		resource['subCategoryData'] = (resource.data.subcategories ?? []).flatMap((subcat: { id: string; collection: string }) => subCategoriesById.get(subcat.id) ?? []);
	});
}
---

<div class="ResourceContainer">
	{page && (
		<Pagination
			currentPage={page.currentPage}
			lastPage={page.lastPage}
			firstUrl={page.url.first ?? page.url.current}
			next={page.url.next}
			prev={page.url.prev}
			boxHeader={false}
		/>
	)}

	{resources && resources.length > 0 ? (
		<ol class="ResourceList">
			{r.map((resource) => <li class="ResourceItem">
				<div class="ResourceName">
					<h4 class="ResourceTitle" transition:name={`${resource.id} title`}>
						{resource.id && <a class="ResourceLink" href={`/r/${resource.id}`} title={`Vizitează resursa intitulată: ${resource.data.title}`}>
							{resource.data.title}
							{resourceTypeIcon[resource.data.type]}
						</a>}
						<button class="ResourceStatus" type="button" title="Marchează resursa ca fiind neparcursă">✅</button>
					</h4>
				</div>
				<div class="ResourceAside ResourceInfo">
					<h5 class="WidgetTitle">Informații utile:</h5>
					<ul class="InfoList">
						<li class="InfoItem" transition:name={`${resource.id} rating`}>
							<div class="InfoItemLabel">
								<span class="Icon IconRating">
									<span class="SROnly">⭐</span>
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"
										/>
									</svg>
								</span>
								<span class="InfoItemText">Rating-ul link-ului</span>
							</div>
							<strong class="InfoItemValue">{formatRating(resource.data.rating)}</strong>
						</li>
						{resource.data.requiredTime && <li class="InfoItem" transition:name={`${resource.id} time`}>
							<div class="InfoItemLabel">
								<span class="Icon IconTime">
									<span class="SROnly">⏰</span>
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
										<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
									</svg>
								</span>
								<span class="InfoItemText">Timp necesar</span>
							</div>
							<strong class="InfoItemValue">{resource.data.requiredTime}h</strong>
						</li>}
					</ul>
				</div>
				<div class="ResourceMainContent">
					<ResourceLocationList res={resource} />
					{resource.data.description && <p class="ResourceP" transition:name={`${resource.id} description`}>
						{resource.data.description}
					</p>}
					{resource.data.tags && <ResourceTagList taglist={resource.tagData} resslug={resource.id} />}
				</div>
				<ResourceActionList res={resource} />
			</li>)}
		</ol>
	) : (
		<Message title="Nu s-au găsit resurse pentru contextul curent" type="error">
			<HelpfulLinks />
		</Message>
	)}

	{/*
		error && (
			<Message title="Am întâmpinat o problemă cu baza de date." type="error">
				<HelpfulLinks />
			</Message>
		)
		*/}

	{page && (
		<Pagination
			currentPage={page.currentPage}
			lastPage={page.lastPage}
			firstUrl={page.url.first ?? page.url.current}
			next={page.url.next}
			prev={page.url.prev}
			boxHeader={true}
			pageTitle={pageTitle}
		/>
	)}
</div>
