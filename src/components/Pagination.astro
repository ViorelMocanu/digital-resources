---
/**
 * Renders a pagination navigation bar based on the provided props.
 * @component
 * @example
 * ```astro
 * <Pagination page={page} boxHeader={true} pageTitle="Blog" />
 * ```
 * @property {ListPage} page - The list page: its number, the last page number and its addresses.
 * @property {number} page.currentPage - The current page number.
 * @property {number} page.lastPage - The last page number.
 * @property {string} page.url.current - The address of this page; on page 1 it is the list's first page.
 * @property {string} [page.url.first] - The address of the list's first page, from page 2 on; every numbered link is built from it.
 * @property {string} [page.url.next] - The URL for the next page.
 * @property {string} [page.url.prev] - The URL for the previous page.
 * @property {boolean} [boxHeader] - Flag for displaying a box header. Default is true.
 * @property {string} [pageTitle] - The page title.
 * @returns {astro.AstroNode} The rendered pagination navigation bar component.
 */

import { type ListPage, pageUrl } from '@utils/pagination';

export interface Props {
	page: ListPage;
	boxHeader?: boolean;
	pageTitle?: string | undefined;
}

const { page, boxHeader = true, pageTitle } = Astro.props satisfies Props;
const { currentPage, lastPage } = page;
const { next, prev } = page.url;
const firstUrl = page.url.first ?? page.url.current;
const paginationList = Array.from({ length: Number(lastPage) }, (_, i) => i + 1);
const groups =
	lastPage <= 15
		? []
		: currentPage < 4 || currentPage > lastPage - 3
			? [paginationList.slice(0, 4), paginationList.slice(-4)]
			: [paginationList.slice(0, 2), paginationList.slice(currentPage - 2, currentPage + 1), paginationList.slice(-2)];
---

<nav class="Pagination">
	{boxHeader && <h3 class="PaginationTitle">
		Ești pe pagina <strong>{currentPage}</strong> din <strong>{lastPage}</strong>&#32; {pageTitle && <span>în zona de {pageTitle}</span>}.&#32;
		{lastPage > 1 && <span>Navighează către altă pagină:</span>}
	</h3>}
	{lastPage > 1 && <ol class="PaginationList">
		<li class="PaginationItem PaginationPrevious">
			{currentPage > 1 ? (
				<a class="PaginationLink" href={prev} title="Mergi la pagina precedentă"> &laquo; Precedenta<span class="HideLowRes"> Pagină</span> </a>
			) : (
				<span class="PaginationUnavailable">Ești pe prima pagină</span>
			)}
		</li>
		{groups.map((group, g) => (
			<>
				{g > 0 && <li class="PaginationItem PaginationEllipsis">
					<span class="SpacerSymbol">...</span>
				</li>}
				{group.map((num) => <li class:list={['PaginationItem', num === currentPage && 'PaginationCurrent']}>
					<a class="PaginationLink" href={pageUrl(firstUrl, num)} title={`Mergi la pagina ${num} din ${lastPage}`}>
						{num}
					</a>
				</li>)}
			</>
		))}
		<li class="PaginationItem PaginationNext">
			{currentPage < lastPage ? (
				<a class="PaginationLink" href={next} title="Mergi la pagina următoare"> Următoarea<span class="HideLowRes"> Pagină</span> &raquo; </a>
			) : (
				<span class="PaginationUnavailable">Ești pe ultima pagină</span>
			)}
		</li>
	</ol>}
</nav>
