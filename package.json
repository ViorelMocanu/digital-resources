{
	"name": "@viorelmocanu/digital-resources",
	"displayName": "Resurse.dev - Digital resources by Viorel Mocanu",
	"publisher": "ViorelMocanu",
	"description": "Discover thousands of useful resources for learning digital skills: Front End Development, Back End Development, UI/UX Design, Digital Marketing, Cyber Security and more.",
	"type": "module",
	"version": "0.1.0",
	"icon": "public/favicon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/ViorelMocanu/digital-resources"
	},
	"homepage": "https://resurse.dev",
	"engines": {
		"node": ">=24.16",
		"pnpm": ">=10"
	},
	"packageManager": "pnpm@10.33.2",
	"license": "ISC",
	"keywords": [
		"astro",
		"astro3",
		"resources",
		"css",
		"scss",
		"html",
		"learning",
		"list",
		"figma"
	],
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"format": "prettier --check \"./**/*.{html,css,js,cjs,ts,astro,md,json,yaml}\" --plugin=prettier-plugin-astro",
		"format:fix": "prettier --write \"./**/*.{html,css,js,cjs,ts,astro,md,json,yaml}\" --plugin=prettier-plugin-astro",
		"lint:js": "eslint \"**/*.js\" \"**/*.ts\" \"**/*.astro\"",
		"lint:md": "markdownlint \"./src/**/*.md\"",
		"lint:css": "stylelint \"src/style/*.scss\"",
		"lint:fix": "pnpm lint:js --fix && pnpm lint:md --fix && pnpm lint:css --fix",
		"lint": "pnpm lint:js && pnpm lint:md && pnpm lint:css",
		"postinstall": "husky",
		"coverage": "pnpm test:unit --coverage",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test": "pnpm test:unit && pnpm test:e2e",
		"typecheck": "pnpm astro check && pnpm tsc --project tsconfig.json",
		"verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm harness:sync:check && pnpm format",
		"verify:fix": "pnpm lint:fix && pnpm typecheck && pnpm test:unit && pnpm harness:sync && pnpm format:fix",
		"harness:sync": "node scripts/sync-harness.ts",
		"harness:sync:check": "node scripts/sync-harness.ts --check",
		"harness:sync:diff": "node scripts/sync-harness.ts --diff",
		"openspec:port": "node scripts/openspec-port.ts",
		"upd": "pnpm update --latest --recursive --interactive"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.6",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/vercel": "^11.0.20",
		"@vercel/speed-insights": "^1.0.12",
		"astro": "^7.4.7",
		"astro-capo": "^0.0.1",
		"astro-embed": "^0.14.0",
		"astro-simpleanalytics-plugin": "^0.3.17",
		"astro-social-share": "^2.0.2",
		"sass-embedded": "^1.107.1",
		"sharp": "^0.35.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@axe-core/playwright": "4.14.0",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@fission-ai/openspec": "1.16.1",
		"@playwright/test": "1.65.0",
		"@types/semver": "^7.8.0",
		"@vitest/coverage-v8": "^5.1.0",
		"astro-eslint-parser": "^3.2.0",
		"eslint": "^10.14.0",
		"eslint-plugin-astro": "^3.2.1",
		"eslint-plugin-jsdoc": "^65.4.4",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"husky": "^9.1.7",
		"markdownlint-cli": "^0.50.0",
		"prettier": "3.3.3",
		"prettier-plugin-astro": "0.14.1",
		"semver": "^7.8.6",
		"stylelint": "^17.16.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.1.0"
	}
}
